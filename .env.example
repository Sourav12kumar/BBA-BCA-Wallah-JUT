MYSQL_ROOT_PASSWORD=change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
SITE_URL=https://your-domain.com
APP_PORT=8080
APP_IMAGE=ghcr.io/sourav12kumar/bba-bca-wallah-jut:latest
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Primary resource storage. Use local for development or s3 for production object storage.
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE=false
STORAGE_S3_KEY_PREFIX=resources
STORAGE_S3_PRESIGN_MINUTES=15

# Local full-site backup settings
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_ON_START=true

# Off-server S3-compatible backup settings
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=your-private-backup-bucket
S3_PREFIX=bba-bca-wallah
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
REMOTE_SYNC_INTERVAL_SECONDS=3600
REMOTE_SYNC_ON_START=true
REMOTE_RETENTION_DAYS=30
